{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "-opencode.notifications",
    "./herdr-opencode"
  ],
  "diffs": {
    "wrap": "word"
  },
  "tabs": {
    "mode": "off"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "keybinds": {
    "session.tab.close": "ctrl+q",
    "session.tab.next": "ctrl+n",
    "session.tab.previous": "ctrl+p"
  },
  "attention": {
    "notifications": true,
    "sound": false
  }
}
