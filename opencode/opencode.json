{
  "$schema": "https:\/\/opencode.ai\/config.json",
  "mcp": {
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "type": "local"
    },
    "codegraph": {
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "type": "remote",
      "url": "https:\/\/mcp.context7.com\/mcp"
    },
    "lazydb": {
      "type": "local",
      "command": [
        "lazydb",
        "mcp",
        "serve",
        "--project",
        ".",
        "--write-policy",
        "non-production"
      ],
      "cwd": "."
    }
  },
  "permission": {
    "*": "allow",
    "lazydb_get_context": "allow",
    "lazydb_list_connections": "allow",
    "lazydb_search_schema": "allow",
    "lazydb_describe_object": "allow",
    "lazydb_query": "allow",
    "lazydb_execute_change": "ask",
    "lazydb_execute_file": "ask"
  },
  "plugin": [
    "\/Users\/yelog\/workspace\/swift\/VibeBar\/plugins\/opencode-vibebar-plugin"
  ],
  "provider": {
