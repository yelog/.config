{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode 2 uses an ordered rule list. Allow all actions by default.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],

  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "lazydb": {
        "type": "local",
        "disabled": false,
        "command": [
          "lazydb",
          "mcp",
          "serve",
          "--project",
          ".",
          "--write-policy",
          "non-production"
        ],
        "cwd": "."
      }
    }
  },

  "plugins": ["/Users/yelog/.config/opencode-v2/plugins/task-workflow"],

  "providers": {
    "omlx": {
      "name": "oMLX",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "apiKey": "omlx",
        "baseURL": "http://localhost:7011/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B-4bit-MTPLX-Optimized-Speed": {
          "modelID": "Qwen3.6-35B-A3B-4bit-MTPLX-Optimized-Speed",
          "name": "Qwen3.6 35B A3B (oMLX local)",
          "family": "qwen3.6",
          "limit": { "context": 262144, "output": 32768 },
          "capabilities": { "input": ["text"], "output": ["text"], "tools": true }
        }
      }
    },
    "sensenova": {
      "name": "SenseNova",
      "env": ["SENSENOVA_KEY"],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://token.sensenova.cn/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "modelID": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "family": "deepseek-v4",
          "limit": { "context": 1000000, "output": 65536 },
          "capabilities": { "input": ["text"], "output": ["text"], "tools": true }
        },
        "glm-5.2": {
          "modelID": "glm-5.2",
          "name": "GLM-5.2",
          "family": "glm-5",
          "limit": { "context": 1000000, "output": 131072 },
          "capabilities": { "input": ["text"], "output": ["text"], "tools": true }
        },
        "sensenova-6.8-flash-lite": {
          "modelID": "sensenova-6.8-flash-lite",
          "name": "SenseNova 6.8 Flash Lite",
          "family": "sensenova",
          "limit": { "context": 262144, "output": 65536 },
          "capabilities": { "input": ["text", "image"], "output": ["text"], "tools": true }
        },
        "sensenova-u1-fast": {
          "modelID": "sensenova-u1-fast",
          "name": "SenseNova U1 Fast",
          "family": "sensenova-u1",
          "limit": { "context": 32768, "output": 1 },
          "capabilities": { "input": ["text"], "output": ["image"], "tools": false }
        }
      }
    },
    "xrouter": {
      "name": "XRouter",
      "env": ["X_ROUTER_KEY"],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://xrouter.uk/v1"
      },
      "models": {
        "gpt-4o": {
          "modelID": "gpt-4o",
          "name": "GPT 4o",
          "family": "gpt-4",
          "limit": { "context": 400000, "output": 128000 },
          "capabilities": { "input": ["text", "image", "pdf"], "output": ["text"], "tools": true }
        },
        "gpt-5.3-codex": {
          "modelID": "gpt-5.3-codex",
          "name": "GPT-5.3 Codex",
          "family": "gpt-5-codex",
          "limit": { "context": 400000, "output": 128000 },
          "capabilities": { "input": ["text", "image", "pdf"], "output": ["text"], "tools": true }
        },
        "gpt-5.4": {
          "modelID": "gpt-5.4",
          "name": "GPT-5.4",
          "family": "gpt-5",
          "limit": { "context": 1050000, "output": 128000 },
          "capabilities": { "input": ["text", "image", "pdf"], "output": ["text"], "tools": true }
        },
        "gpt-5.5": {
          "modelID": "gpt-5.5",
          "name": "GPT-5.5",
          "family": "gpt-5",
          "limit": { "context": 1050000, "output": 128000 },
          "capabilities": { "input": ["text", "image", "pdf"], "output": ["text"], "tools": true }
        },
        "gpt-5.6-luna": {
          "modelID": "gpt-5.6-luna",
          "name": "GPT-5.6 Luna",
          "family": "gpt-5",
          "limit": { "context": 1050000, "output": 128000 },
          "capabilities": { "input": ["text", "image", "pdf"], "output": ["text"], "tools": true }
        },
        "gpt-6-astra": {
          "modelID": "gpt-6-astra",
          "name": "GPT-6 Astra",
          "family": "gpt-6",
          "limit": { "context": 1050000, "output": 128000 },
          "capabilities": { "input": ["text", "image", "pdf"], "output": ["text"], "tools": true }
        },
        "gpt-5.6-sol": {
          "modelID": "gpt-5.6-sol",
          "name": "GPT-5.6 Sol",
          "family": "gpt-5",
          "limit": { "context": 1050000, "output": 128000 },
          "capabilities": { "input": ["text", "image", "pdf"], "output": ["text"], "tools": true }
        },
        "gpt-5.6-terra": {
          "modelID": "gpt-5.6-terra",
          "name": "GPT-5.6 Terra",
          "family": "gpt-5",
          "limit": { "context": 1050000, "output": 128000 },
          "capabilities": { "input": ["text", "image", "pdf"], "output": ["text"], "tools": true }
        }
      }
    }
  }
}
